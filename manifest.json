{
  "manifest_version": 3,
  "name": "Compactar texto",
  "version": "1.0.0",
  "description": "Quita espacios y guiones de una secuencia de caracteres (eee-222-eee -> eee222eee).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Compactar texto"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Abrir Compactar texto"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "clipboardWrite", "scripting", "activeTab"]
}
